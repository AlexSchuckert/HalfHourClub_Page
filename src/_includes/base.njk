<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{% if pageTitle %}{{ pageTitle }} — {{ site.title }}{% else %}{{ site.title }}{% endif %}</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#fcf9f4" />

    {#
      Hide the page until the stylesheet has landed, then theme.css sets
      visibility back to visible. Without this you get a flash of unstyled,
      fallback-serif text on every load — the same fix the mooring wiki uses.
    #}
    <style>
      body { visibility: hidden; }
    </style>
    <link rel="stylesheet" href="/assets/theme.css" />
    {% for href in pageStyles %}
      <link rel="stylesheet" href="{{ href }}" />
    {% endfor %}
  </head>
  <body>
    <div class="shell">
      <header class="masthead">
        <div>
          <h1 class="masthead__title"><a href="/">{{ site.title }}</a></h1>
          <p class="masthead__tagline">{{ site.tagline }}</p>
        </div>
        {% if not hideNewButton %}
          <a class="button button--primary" href="/new/">＋ New half hour club</a>
        {% endif %}
      </header>

      <main>
        {{ content | safe }}
      </main>

      <footer class="footer">
        <span>{{ clubs.all | length }} half hour club{% if clubs.all | length != 1 %}s{% endif %} so far</span>
        <span><a href="/">Calendar</a></span>
      </footer>
    </div>

    {#
      Pages list their own scripts in front matter as `pageScripts`, rather than
      using a Nunjucks {% block %}: Eleventy's `layout:` chaining injects the
      child's output as `content` and never evaluates child blocks, so a block
      here would silently render nothing.
    #}
    {% for src in pageScripts %}
      <script src="{{ src }}" defer></script>
    {% endfor %}
    {% for src in pageModules %}
      <script src="{{ src }}" type="module"></script>
    {% endfor %}
  </body>
</html>
